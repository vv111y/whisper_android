<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="0dp">

    <PreferenceCategory android:title="Listening">
        <com.whispertflite.ui.pref.ListenModePreference
            android:key="pref_listen_mode"
            android:defaultValue="session" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Model &amp; Media">
        <SwitchPreferenceCompat
            android:key="pref_capture_media"
            android:title="Use earbud media controls"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_normalize_audio"
            android:title="Normalize captured audio"
            android:defaultValue="true" />

        <ListPreference
            android:key="pref_model_file"
            android:title="Model file"
            app:useSimpleSummaryProvider="true"
            android:summary="Select the Whisper .tflite model" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Text-to-Speech">
        <SwitchPreferenceCompat
            android:key="pref_tts_enabled"
            android:title="Enable spoken feedback"
            android:defaultValue="true" />

        <ListPreference
            android:key="pref_tts_interrupt"
            android:title="Interrupt policy"
            android:defaultValue="flush"
            app:entries="@array/tts_interrupt_entries"
            app:entryValues="@array/tts_interrupt_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_tts_double_tap_stop"
            android:title="Double‑tap to stop TTS"
            android:defaultValue="true" />
    </PreferenceCategory>

    <Preference
        android:key="pref_divider_1"
        android:layout="@layout/pref_divider"
        android:selectable="false" />

    <com.whispertflite.ui.pref.ModeRowPreference
        android:key="pref_config_mode"
        android:defaultValue="cmd" />

    <PreferenceCategory android:title="VAD">
        <SeekBarPreference
            android:key="pref_vad_threshold"
            android:title="Threshold"
            app:min="1"
            android:max="100"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="35"
            android:summary="Energy threshold (maps ~0.005..0.1)" />
        <SeekBarPreference
            android:key="pref_vad_hangover"
            android:title="Hangover frames"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="30" />
        <SeekBarPreference
            android:key="pref_vad_attack"
            android:title="Start attack frames"
            app:min="1"
            android:max="10"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="3" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Pipeline">
        <SeekBarPreference
            android:key="pref_pre_roll_frames"
            android:title="Pre-roll frames"
            app:min="0"
            android:max="60"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="18"
            android:summary="Frames kept before speech (~20ms each)" />
        <SeekBarPreference
            android:key="pref_incap_silence_frames"
            android:title="In-capture silence frames"
            app:min="0"
            android:max="150"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="35"
            android:summary="End-of-input merge window" />
        <SeekBarPreference
            android:key="pref_min_arm_delay_ms"
            android:title="Min arm delay (ms)"
            app:min="0"
            android:max="2000"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="600" />
        <SeekBarPreference
            android:key="pref_inter_cooldown_ms"
            android:title="Inter-utterance cooldown (ms)"
            app:min="0"
            android:max="3000"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="800" />
        <SeekBarPreference
            android:key="pref_min_utter_frames"
            android:title="Min utterance frames"
            app:min="1"
            android:max="60"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="18" />
        <SeekBarPreference
            android:key="pref_max_capture_ms"
            android:title="Max capture (ms)"
            app:min="1000"
            android:max="120000"
            app:showSeekBarValue="true"
            app:singleLineTitle="true"
            app:iconSpaceReserved="false"
            android:defaultValue="12000"
            android:summary="Increase for multi-sentence chat (up to 120s)" />
    </PreferenceCategory>

    <com.whispertflite.ui.pref.DualButtonsPreference
        android:key="pref_dual_bottom" />

</PreferenceScreen>
